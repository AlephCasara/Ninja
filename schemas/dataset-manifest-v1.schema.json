{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlephCasara/Ninja/schemas/dataset-manifest-v1.schema.json",
  "title": "Ninja Dataset Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "code_commit",
    "config",
    "sources",
    "artifacts",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "minLength": 1},
    "config": {"type": "object"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "endpoint", "query", "causal_clock"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "endpoint": {"type": "string"},
          "query": {"type": "object"},
          "causal_clock": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "rows": {"type": "integer", "minimum": 0}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
