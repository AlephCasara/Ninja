{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlephCasara/Ninja/schemas/replay-state-v2.schema.json",
  "title": "Ninja Frozen Replay State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "state_hash",
    "replay_type",
    "domain",
    "subject_id",
    "decision_time",
    "availability_policy",
    "representation_version",
    "dataset_manifest_ids",
    "code_revision",
    "observation_ids",
    "observation_fingerprints",
    "interpretation_ids",
    "interpretation_fingerprints",
    "market_fingerprints",
    "information_state",
    "market_state",
    "frozen_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "state_hash": {
      "type": "string",
      "minLength": 64
    },
    "replay_type": {
      "enum": [
        "state",
        "event",
        "propagation",
        "strategy_overlay"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_time": {
      "type": "string",
      "format": "date-time"
    },
    "availability_policy": {
      "enum": [
        "explicit_available_at",
        "published",
        "first_seen"
      ]
    },
    "representation_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_input_available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "information_state": {
      "type": "object",
      "additionalProperties": true
    },
    "market_state": {
      "type": "object",
      "additionalProperties": true
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "interpretation_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "market_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
